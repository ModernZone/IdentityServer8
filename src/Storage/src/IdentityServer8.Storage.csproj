<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Vendored from https://github.com/alexhiggins732/IdentityServer8, pinned commit 08051c9b
      (merge of PR #41 "fix call method fail", tip of master as of 2026-07-01).
      See ../../VENDORED_COMMIT.txt for provenance.

      This csproj is NOT the upstream repo's csproj — it is a minimal replacement authored
      for this solution so the vendored source builds against our net10.0 / Microsoft.IdentityModel
      8.0.1+ dependency floor, without pulling in the upstream repo's own Directory.Build.props /
      Directory.Packages.props / signing-key / NuGet-pack infrastructure (irrelevant here, since
      we consume this as a ProjectReference, not a package).
    -->

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <IsPackable>true</IsPackable>
        <NoWarn>$(NoWarn);CS0618;SYSLIB0023;SYSLIB0020;EF1001</NoWarn>
        <Version>8.0.4-net10.1</Version>
        <PackageId>ModernZone.IdentityServer8.Storage</PackageId>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <Description>Fork of alexhiggins732/IdentityServer8, pinned upstream commit 08051c9b, maintained by ModernZone for net10 compatibility.</Description>
        <PackageReleaseNotes>Fork of alexhiggins732/IdentityServer8, pinned upstream commit 08051c9b, maintained by ModernZone for net10 compatibility.</PackageReleaseNotes>
        <RepositoryUrl>https://github.com/ModernZone/IdentityServer8</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <Authors>ModernZone</Authors>
        <PackageProjectUrl>https://github.com/ModernZone/IdentityServer8</PackageProjectUrl>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="IdentityModel" Version="6.2.0" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    </ItemGroup>

</Project>
